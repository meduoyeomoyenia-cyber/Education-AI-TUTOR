# secrets
backend/.env
*.env
# databases (regenerable via seed scripts)
*.db
*.db-journal
*.db-wal
*.db-shm
# frontend
web/node_modules/
web/.next/
web/out/
# python
__pycache__/
*.pyc
.pytest_cache/
