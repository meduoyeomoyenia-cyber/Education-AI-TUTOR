# Copy to .env and fill in. Never commit real keys.
# ALOC question provider (first provider in the provider architecture).
ALOC_API_KEY=
ALOC_BASE_URL=https://dev.aloc.com.ng
# Path of the questions endpoint, appended to the base URL.
ALOC_QUESTIONS_PATH=/api/v1/questions
# Header carrying the key (ALOC uses X-API-Key).
ALOC_KEY_HEADER=X-API-Key
# Provenance stamped on ALOC imports; blank means teacher must supply it at review.
ALOC_LICENSE=
